{
  "manifest_version": 3,
  "name": "SHROUD // WhatsApp Sticker Forge & Sound Bridge",
  "version": "1.1.0",
  "description": "Send GIF/video links to SHROUD Sticker Forge and publish animated stickers with sound directly to WhatsApp Web.",
  "permissions": ["activeTab", "tabs"],
  "host_permissions": ["https://web.whatsapp.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "SHROUD Sticker Forge",
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icon128.png"
    }
  },
  "icons": {
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://walterdotblend.github.io/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["shroud_bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["wa_bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["wa_sender.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "shroud-forge@walterdotblend.github.io",
      "strict_min_version": "109.0"
    }
  }
}
