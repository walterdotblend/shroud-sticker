{
  "name": "crimson-sticker",
  "version": "1.0.0",
  "private": true,
  "description": "100% client-side WhatsApp animated sticker studio powered by FFmpeg.wasm and ArrowBrake-inspired encoding & WebGL architecture.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.10",
    "@ffmpeg/util": "^0.12.1",
    "jszip": "^3.10.2",
    "lucide-react": "^0.460.0",
    "omggif": "^1.0.10",
    "peerjs": "^1.5.5",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@ffmpeg/core": "0.12.6",
    "@ffmpeg/core-mt": "0.12.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
